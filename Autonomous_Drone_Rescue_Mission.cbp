<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
    <FileVersion major="1" minor="6" />
    <Project>
        <Option title="Autonomous Drone Rescue Mission" />
        <Option pch_mode="2" />
        <Option compiler="gcc" />
        <Build>
            <Target title="Debug">
                <Option output="bin/Debug/Autonomous_Drone_Rescue_Mission" prefix_auto="1" extension_auto="1" />
                <Option object_output="obj/Debug/" />
                <Option type="1" />
                <Option compiler="gcc" />
                <Compiler>
                    <Add option="-std=c++11" />
                </Compiler>
                <Linker>
                    <Add library="freeglut" />
                    <Add library="opengl32" />
                    <Add library="glu32" />
                </Linker>
            </Target>
            <Target title="Release">
                <Option output="bin/Release/Autonomous_Drone_Rescue_Mission" prefix_auto="1" extension_auto="1" />
                <Option object_output="obj/Release/" />
                <Option type="1" />
                <Option compiler="gcc" />
                <Compiler>
                    <Add option="-std=c++11" />
                    <Add option="-O2" />
                </Compiler>
                <Linker>
                    <Add library="freeglut" />
                    <Add library="opengl32" />
                    <Add library="glu32" />
                </Linker>
            </Target>
        </Build>
        <Unit filename="Autonomous_Drone_Rescue_Mission.cpp">
            <Option compilerVar="CPP" />
            <Option target="Debug;Release" />
        </Unit>
    </Project>
</CodeBlocks_project_file>
